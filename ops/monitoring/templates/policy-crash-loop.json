{
  "displayName": "vca-@ENV@ crash loop",
  "documentation": {
    "mimeType": "text/markdown",
    "content": "Cloud Run logged 3 or more instance errors (non-zero exit, failed startup probe) for @SERVICE@ in 15 minutes. What to do: ops/monitoring/README.md section crash loop."
  },
  "userLabels": { "service": "venue-call-agent", "env": "@ENV@" },
  "severity": "CRITICAL",
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": ["@CHANNEL@"],
  "alertStrategy": { "autoClose": "3600s" },
  "conditions": [
    {
      "displayName": "instance errors over 15 min > 2",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/vca_container_exit_@ENV@\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [
          {
            "alignmentPeriod": "900s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": ["resource.label.service_name"]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ]
}
