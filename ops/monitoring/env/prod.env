# Parameters for the prod monitoring set. Sourced by ops/monitoring/apply.sh; KEY=VALUE only.
ENV_NAME=prod
# The Cloud Run service (cloudbuild-prod.yaml, step `deploy`). Not created until the release (it-14):
# until it exists, apply.sh skips the uptime check and its policy and says so.
SERVICE=venue-call-agent
# Monthly budget ALERT in USD, the dev amount until someone changes this one line. Filtered on the
# label env=prod; see README "The budget" for what that label must be on.
BUDGET_USD=50
# Uptime check period in minutes (1, 5, 10 or 15).
UPTIME_PERIOD_MIN=15
