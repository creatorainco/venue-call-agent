# Parameters for the dev monitoring set. Sourced by ops/monitoring/apply.sh; KEY=VALUE only.
ENV_NAME=dev
# The Cloud Run service (cloudbuild.yaml, step `deploy`).
SERVICE=venue-call-agent-dev
# Monthly budget ALERT in USD (Peter 2026-11-13, B3). A budget spends nothing; it emails and publishes.
BUDGET_USD=50
# Uptime check period in minutes (1, 5, 10 or 15). Each check can cold-start an instance; see README.
UPTIME_PERIOD_MIN=15
