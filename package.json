{
  "name": "venue-call-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Layer E: the voice that telephones a restaurant before a creator's booking. Dials nobody.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "mock": "node src/mock/cli.ts",
    "harness": "node src/harness/run.ts",
    "call": "node src/carrier/run.ts",
    "doctor": "node scripts/doctor.mjs",
    "eval": "node src/eval/run.ts",
    "check:no-facts": "node scripts/check-no-facts.mjs",
    "contract:derive": "node scripts/derive-contract.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:no-facts && node scripts/doctor.mjs --control && npm run typecheck && npm test",
    "mint-token": "node scripts/mint-token.mjs",
    "probe:speech": "node scripts/probe-speech.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google-cloud/speech": "8.2.1",
    "google-auth-library": "11.3.2",
    "ws": "8.22.1"
  }
}
